# Never commit the real .env file.
GEMINI_API_KEY=

# Comma-separated browser origins for development or a separate frontend.
# The production Nginx route uses same-origin /api.
CORS_ORIGINS=https://209.38.197.161,http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=/api

# Synchronous request admission and Planetary Computer limits.
MAX_GEOJSON_BYTES=500000
MAX_AOI_VERTICES=10000
MAX_SYNC_BBOX_KM2=100
MAX_NDVI_BBOX_KM2=10
MAX_PC_SCENES=4
MAX_CONCURRENT_ANALYSES=1
