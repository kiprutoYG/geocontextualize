# Keep secrets in the untracked .env file.
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call the API directly. The
# production frontend uses the same-origin /api reverse-proxy route.
CORS_ORIGINS=https://209.38.197.161
NEXT_PUBLIC_BACKEND_URL=/api

# Synchronous request safety limits. Areas above the first cap are rejected;
# NDVI is skipped above its tighter Sentinel-2 cap.
MAX_SYNC_BBOX_KM2=100
MAX_NDVI_BBOX_KM2=10
MAX_CONCURRENT_ANALYSES=1
MAX_PC_SCENES=4
MAX_AOI_VERTICES=10000
MAX_GEOJSON_BYTES=500000
STAC_RETRIES=2
NDVI_TIMEOUT_SECONDS=90
